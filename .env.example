# 907.life Environment Variables
# Set these in Cloudflare Workers dashboard: Settings -> Variables
# NEVER commit actual secrets to git!

# Cloudflare Turnstile
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
# Site Key (public): 0x4AAAAAACPc3bf8bl6ifC3c (already in about.html)
# Secret Key (private): Set in Cloudflare dashboard as encrypted variable
TURNSTILE_SECRET_KEY=0x4AAAAAACPc3X9Ux49F7FaTgulwsatcOZA

# Contact destination
# Email address where contact form submissions will be sent
CONTACT_EMAIL=geoff@907.life

# Note: Email is sent via MailChannels (free for Cloudflare Workers)
# No additional email credentials needed!

# How to set these in Cloudflare:
# 1. Go to Cloudflare Dashboard -> Compute (Workers) -> Workers & Pages
# 2. Select "907-life" worker
# 3. Go to Settings -> Variables
# 4. Add variables:
#    - TURNSTILE_SECRET_KEY (type: Encrypted)
#    - CONTACT_EMAIL (type: Plain text)
# 5. Click "Deploy" to apply changes
