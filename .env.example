# Cloudflare Turnstile
# Get these from: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Fastmail JMAP
# Create an App Password at: https://www.fastmail.com/settings/security/devicekeys
# Get Account ID from JMAP session: https://api.fastmail.com/jmap/session
FASTMAIL_API_TOKEN=your-fastmail-app-password-here
FASTMAIL_ACCOUNT_ID=your-fastmail-account-id-here

# Contact destination
CONTACT_EMAIL=geoff@907.life
